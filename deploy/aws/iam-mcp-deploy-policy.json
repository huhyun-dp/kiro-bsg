{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Ec2AndNetworkingForDeploy",
      "Effect": "Allow",
      "Action": [
        "ec2:*"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-northeast-2"
        }
      }
    },
    {
      "Sid": "RdsForDeploy",
      "Effect": "Allow",
      "Action": [
        "rds:*"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-northeast-2"
        }
      }
    },
    {
      "Sid": "BudgetsForCostAlerts",
      "Effect": "Allow",
      "Action": [
        "budgets:ViewBudget",
        "budgets:ModifyBudget",
        "budgets:CreateBudgetAction",
        "budgets:DescribeBudgetAction",
        "budgets:UpdateBudgetAction",
        "budgets:DeleteBudgetAction"
      ],
      "Resource": "*"
    },
    {
      "Sid": "IamForInstanceProfileOnlyWhenSsmEnabled",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:GetRole",
        "iam:PassRole",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies",
        "iam:CreateInstanceProfile",
        "iam:DeleteInstanceProfile",
        "iam:GetInstanceProfile",
        "iam:AddRoleToInstanceProfile",
        "iam:RemoveRoleFromInstanceProfile"
      ],
      "Resource": [
        "arn:aws:iam::*:role/bsg-session-auth-*",
        "arn:aws:iam::*:instance-profile/bsg-session-auth-*"
      ]
    },
    {
      "Sid": "ReadOnlyHelpersForVerification",
      "Effect": "Allow",
      "Action": [
        "sts:GetCallerIdentity",
        "pricing:GetProducts",
        "ce:GetCostAndUsage"
      ],
      "Resource": "*"
    }
  ]
}
