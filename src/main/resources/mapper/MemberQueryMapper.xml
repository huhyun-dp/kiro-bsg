<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lxpantos.auth.adapter.out.persistence.mybatis.MemberQueryMapper">

    <resultMap id="memberQueryResultMap" type="com.lxpantos.auth.application.port.out.MemberQueryResult">
        <constructor>
            <idArg column="id" javaType="java.lang.Long"/>
            <arg column="name" javaType="java.lang.String"/>
            <arg column="email" javaType="java.lang.String"/>
            <arg column="phone_number" javaType="java.lang.String"/>
            <arg column="created_at" javaType="java.time.LocalDateTime"/>
            <arg column="last_login_at" javaType="java.time.LocalDateTime"/>
        </constructor>
    </resultMap>

    <select id="search" resultMap="memberQueryResultMap">
        SELECT id, name, email, phone_number, created_at, last_login_at
        FROM members
        <if test="keywordPattern != null">
            WHERE LOWER(name) LIKE #{keywordPattern} ESCAPE '!'
               OR LOWER(email) LIKE #{keywordPattern} ESCAPE '!'
               OR phone_number LIKE REPLACE(#{keywordPattern}, '-', '') ESCAPE '!'
        </if>
        ORDER BY last_login_at DESC, id ASC
    </select>
</mapper>
