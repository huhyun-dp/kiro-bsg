<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lxpantos.auth.adapter.out.persistence.mybatis.InquiryQueryMapper">

    <resultMap id="inquiryListQueryResultMap" type="com.lxpantos.auth.application.port.out.InquiryListQueryResult">
        <constructor>
            <idArg column="id"               javaType="java.lang.Long"/>
            <arg   column="title"            javaType="java.lang.String"/>
            <arg   column="view_count"       javaType="java.lang.Long"/>
            <arg   column="created_at"       javaType="java.time.LocalDateTime"/>
            <arg   column="attachment_count" javaType="_long"/>
        </constructor>
    </resultMap>

    <select id="findPage" resultMap="inquiryListQueryResultMap">
        SELECT i.id,
               i.title,
               i.view_count,
               i.created_at,
               (
                   SELECT COUNT(*)
                   FROM inquiry_attachments a
                   WHERE a.inquiry_id = i.id
               ) AS attachment_count
        FROM inquiries i
        JOIN members m ON m.id = i.member_id
        WHERE i.deleted = FALSE
        ORDER BY i.created_at DESC, i.id DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="countAll" resultType="long">
        SELECT COUNT(*) FROM inquiries WHERE deleted = FALSE
    </select>

</mapper>
