MYSQL_ROOT_PASSWORD=change-this-root-password
MYSQL_DATABASE=lx_auth
MYSQL_USER=lx_app
MYSQL_PASSWORD=lx_app_password
MYSQL_PORT=3306

# Spring Boot 실행 환경 변수와 동일하게 맞춥니다.
DB_URL=jdbc:mysql://localhost:3306/lx_auth?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Seoul&connectionTimeZone=Asia/Seoul&forceConnectionTimeZoneToSession=true
DB_USERNAME=lx_app
DB_PASSWORD=lx_app_password
SESSION_COOKIE_SECURE=false
BCRYPT_STRENGTH=12
THYMELEAF_CACHE=false
SEED_DEMO_MEMBERS=true

# 초기 관리자 지정: 앱 시작 시 해당 이메일 회원을 ADMIN/ACTIVE 로 승격합니다.
# 신규 가입자는 모두 VIEWER 이므로 운영 환경에서 최초 관리자를 지정할 때 사용합니다.
# 비워 두면 아무 것도 하지 않습니다.
BOOTSTRAP_ADMIN_EMAIL=
